#!/usr/bin/env bash
set -Eeuo pipefail

# Fetch one explicitly allowed Secrets Manager value into host tmpfs.  Secret
# bytes never cross argv or an environment variable.  The caller supplies only
# the non-secret ARN, target name, encoding and numeric owner contract.

secret_arn=
target_name=
encoding=
target_uid=
target_gid=
target_mode=0400
secret_root=/run/slurm-secrets

die() {
    printf '[slurm-secret] ERROR: %s\n' "$*" >&2
    exit 1
}

while (($#)); do
    case $1 in
        --secret-arn) secret_arn=${2:-}; shift 2 ;;
        --target-name) target_name=${2:-}; shift 2 ;;
        --encoding) encoding=${2:-}; shift 2 ;;
        --uid) target_uid=${2:-}; shift 2 ;;
        --gid) target_gid=${2:-}; shift 2 ;;
        --mode) target_mode=${2:-}; shift 2 ;;
        *) die "unknown or incomplete argument: $1" ;;
    esac
done

((EUID == 0)) || die 'must run as root to set the runtime owner'
command -v aws >/dev/null 2>&1 || die 'AWS CLI is required'
command -v base64 >/dev/null 2>&1 || die 'base64 is required'
[[ $secret_arn == arn:aws:secretsmanager:* ]] || die 'invalid Secrets Manager ARN'
[[ $secret_arn != *[[:space:]]* ]] || die 'secret ARN must not contain whitespace'
[[ $target_name =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] ||
    die 'target name contains unsupported characters'
[[ $encoding == binary || $encoding == string ]] ||
    die 'encoding must be binary or string'
[[ $target_uid =~ ^[0-9]+$ && $target_gid =~ ^[0-9]+$ ]] ||
    die 'uid and gid must be numeric'
[[ $target_mode == 0400 || $target_mode == 0600 ]] ||
    die 'mode must be 0400 or 0600'
[[ ! -L $secret_root ]] || die "$secret_root must not be a symbolic link"

umask 077
# Search-only traversal lets a fixed service UID read its own 0400 file when a
# container mounts this directory.  Only root can list or mutate entries.
install -d -o root -g root -m 0711 "$secret_root"
target="$secret_root/$target_name"
[[ ! -L $target ]] || die "refusing symbolic-link target $target"
temporary=$(mktemp "$secret_root/.${target_name}.XXXXXXXX")
trap 'rm -f -- "$temporary"' EXIT

if [[ $encoding == binary ]]; then
    # Secrets Manager returns SecretBinary base64-encoded through the CLI.
    # pipefail makes a failed fetch or decode leave the old target untouched.
    aws --no-cli-pager secretsmanager get-secret-value \
        --secret-id "$secret_arn" --query SecretBinary --output text |
        base64 --decode > "$temporary"
else
    aws --no-cli-pager secretsmanager get-secret-value \
        --secret-id "$secret_arn" --query SecretString --output text > "$temporary"
fi

[[ -s $temporary ]] || die 'Secrets Manager returned an empty value'
secret_size=$(stat --format='%s' "$temporary")
((secret_size <= 1048576)) || die 'secret exceeds the 1 MiB local policy limit'
chown "$target_uid:$target_gid" "$temporary"
chmod "$target_mode" "$temporary"
# Atomic rename means a daemon sees either the previous complete value or the
# new complete value, never a partially downloaded credential.
mv -f -- "$temporary" "$target"
trap - EXIT
printf '[slurm-secret] materialized %s for uid %s\n' "$target_name" "$target_uid" >&2
