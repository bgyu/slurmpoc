# This file contains identifiers, not the value.  Install root:root 0600 as
# /etc/slurm-production/secrets/munge.env on authorized cluster hosts.
SECRET_ARN=arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:slurm/production-a/munge-EXAMPLE
TARGET_NAME=munge.key
SECRET_ENCODING=binary
TARGET_UID=0
TARGET_GID=0
TARGET_MODE=0400
