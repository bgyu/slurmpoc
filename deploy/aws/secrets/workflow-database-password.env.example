# Identifier-only input for the workflow broker host.  Install root:root 0600;
# the materialized secret itself belongs only to the fixed workflow uid 64032.
SECRET_ARN=arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:slurm/production-a/workflow-database-password-EXAMPLE
TARGET_NAME=workflow-database-password
SECRET_ENCODING=string
TARGET_UID=64032
TARGET_GID=64032
TARGET_MODE=0400
