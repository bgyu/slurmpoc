# This is a high-entropy same-host gateway-to-broker credential, not an OIDC
# token and not a user credential.  Rotate it under the gateway/broker runbook.
# Use a distinct secret ARN for each gateway/broker host (this example is a).
SECRET_ARN=arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:slurm/production-a/workflow-proxy-token-a-EXAMPLE
TARGET_NAME=workflow-proxy-token
SECRET_ENCODING=string
TARGET_UID=64032
TARGET_GID=64032
TARGET_MODE=0400
