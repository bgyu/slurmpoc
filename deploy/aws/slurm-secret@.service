[Unit]
Description=Materialize Slurm runtime secret %i from AWS Secrets Manager
Wants=network-online.target
After=network-online.target
Before=slurm-controller@primary.service slurm-controller@backup.service
Before=slurmdbd@primary.service slurmdbd@backup.service
Before=slurmd@.service workflow-broker.service
ConditionPathExists=/etc/slurm-production/secrets/%i.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/slurm-production/secrets/%i.env
ExecStart=/usr/local/libexec/slurm/materialize-aws-secret --secret-arn ${SECRET_ARN} --target-name ${TARGET_NAME} --encoding ${SECRET_ENCODING} --uid ${TARGET_UID} --gid ${TARGET_GID} --mode ${TARGET_MODE}
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/slurm-secrets
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=

# No [Install] section on purpose.  A role-specific provisioning unit explicitly
# Wants= the exact secret instances it needs; hosts must not fetch every cluster
# secret merely because this template is installed.
