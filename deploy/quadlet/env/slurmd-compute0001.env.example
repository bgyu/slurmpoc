# Example for a non-cloud FUTURE identity named compute0001.  Both variables
# are required together, and these are the singular names consumed by the
# image entrypoint.  AWS State=CLOUD instances must leave this file empty and
# use an instance name such as slurmd@aws-cpu0001 instead.
SLURMD_FEATURE=cpu-standard
SLURM_CONF_SERVER=controller-primary:6817,controller-backup:6817
