BROKER_DATABASE_URL=mariadb://workflow-db.internal.example/workflow
BROKER_DATABASE_USER=workflow
BROKER_DATABASE_CONNECT_TIMEOUT=5
# The authenticating workflow gateway is a same-host process.  Do not trust a
# whole application subnet to assert tenant/user headers.
BROKER_TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Master callbacks also traverse the same-host gateway, so the broker sees a
# loopback peer.  The gateway/security group restricts the public callback
# route to the compute tier; the broker additionally requires the one-use
# workflow capability.
BROKER_CALLBACK_TRUSTED_CIDRS=127.0.0.1/32
WORKFLOW_PUBLIC_BASE_URL=https://workflow.internal.example
SLURM_REST_URL=https://slurm-api.internal.example
SLURM_REST_SUBMIT_USER=workflow
