[Unit]
Description=Private Slurm REST daemon (%i)
Wants=network-online.target
After=network-online.target

[Container]
Image=slurm-runtime.image
ContainerName=slurmrestd-%i
HostName=slurmrestd-%i
Network=host
Pull=never
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
AddCapability=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
Environment=CONTAINER_ROLE=restd
Environment=CLUSTER_DEPLOYMENT_PROFILE=production
Environment=SLURM_CONFIG_FILE=/run/site/slurm.conf
Environment=SLURM_JWKS_FILE=/run/site/slurm-jwks.json
Environment=SLURM_TLS_CA_FILE=/run/site/cluster-ca.pem
Environment=SLURM_TLS_CERT_FILE=/run/site/tls-cert.pem
Environment=SLURM_TLS_KEY_FILE=/run/site/tls-key.pem
Environment=SLURM_API_VERSION=v0.0.45
# Loopback is intentional.  An OIDC-aware TLS gateway on the same host is the
# only network peer; security groups also deny port 6820 from the VPC.
Environment=SLURMRESTD_LISTEN=https://127.0.0.1:6820
Environment=SLURMRESTD_THREADS=16
EnvironmentFile=/etc/slurm-production/env/slurmrestd-%i.env
Volume=/etc/slurm-production/config/slurm.conf:/run/site/slurm.conf:ro,z,nodev,nosuid,noexec
# Mount public trust as an input.  The root supervisor validates it contains
# no private RSA fields, then copies it into private /run ownership for the
# unprivileged slurmrestd identity at the path required by slurm.conf.
Volume=/etc/slurm-production/trust/slurm-jwks.json:/run/site/slurm-jwks.json:ro,z,nodev,nosuid,noexec
Volume=/etc/slurm-production/trust/cluster-ca.pem:/run/site/cluster-ca.pem:ro,z,nodev,nosuid,noexec
Volume=/run/slurm-pki/slurmrestd-%i/cert.pem:/run/site/tls-cert.pem:ro,Z,nodev,nosuid,noexec
Volume=/run/slurm-pki/slurmrestd-%i/key.pem:/run/site/tls-key.pem:ro,Z,nodev,nosuid,noexec
Tmpfs=/run:rw,nodev,nosuid,noexec,size=128m,mode=0755
Tmpfs=/tmp:rw,nodev,nosuid,noexec,size=64m,mode=1777
Tmpfs=/var/log:rw,nodev,nosuid,noexec,size=128m,mode=0755
PidsLimit=1024
Memory=2G
HealthCmd=/usr/local/sbin/cluster-healthcheck
HealthInterval=15s
HealthTimeout=5s
HealthRetries=4
HealthStartPeriod=45s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=2min
TimeoutStopSec=1min
LimitNOFILE=65536
UMask=0077
ExecStartPre=/usr/bin/test -s /etc/slurm-production/trust/slurm-jwks.json
ExecStartPre=/usr/bin/test -s /run/slurm-pki/slurmrestd-%i/key.pem

[Install]
WantedBy=multi-user.target
